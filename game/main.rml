<Rive version="1" kind="fragment">
    <!--
      Fast5 in Rive. The main artboard is UI (ui.rml): the original game's
      screens and HUD, with the game itself under them as a scripted layout
      (src/game.as) that draws the city, the cars, the vault and the cables
      through the GPU API, and the minimap. data.rml is the view model the
      game script drives. This file holds the assets the script reads.
    -->
    <ScriptAsset file="src/game.as" name="game" id="1:1"/>
    <BlobAsset file="assets/map.bin" name="map" id="1:2"/>
    <BlobAsset file="assets/charger.mesh" name="charger" id="1:3"/>
    <BlobAsset file="assets/police.mesh" name="police" id="1:4"/>
    <BlobAsset file="assets/skyline.mesh" name="skyline" id="1:5"/>
</Rive>
